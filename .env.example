# MiliPay — environment contract
# Copy to .env and fill in. NEVER commit the filled-in file.
#
# Anything prefixed VITE_ or EXPO_PUBLIC_ is compiled into the client bundle and
# is readable by anyone who inspects the app. Operator and platform secrets must
# only ever be set as Supabase Edge Function secrets.

# ─────────────────────────────────────────────────────────────
# Client-safe (web portals)
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where each portal is served. These are handed to a new member of staff along
# with their one-time password, and shown on their staff record, so an
# unconfigured one prints nothing rather than a guess. They were previously
# hardcoded to http://localhost:5173/4/5.
VITE_ADMIN_PORTAL_URL=http://localhost:5173
VITE_AGENT_PORTAL_URL=http://localhost:5174
VITE_SUPPORT_PORTAL_URL=http://localhost:5175

# Allows the palm scanner to produce a clearly-marked SIMULATED template when no
# HFSecurity hardware is attached. Only honoured in a dev build; simulated
# templates are refused at enrolment unless this is on.
VITE_ALLOW_BIOMETRIC_SIMULATION=false

# ─────────────────────────────────────────────────────────────
# Server-only — Supabase Edge Function secrets
#   supabase secrets set KEY=value
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sovereign palm-vein matching microservice (C++ / VP930 Linux SDK).
# REQUIRED: process-payment declines every transaction while this is unset,
# because an unverified palm must never move money.
PALM_MATCH_URL=
PALM_MATCH_SERVICE_KEY=

# The matcher reports the SDK's own GetRecognitionThreshold and that is what
# applies. This value can only ever TIGHTEN it, never loosen it, so a bad
# deploy cannot make matching more permissive than the algorithm vendor allows.
# Leave it unset to use the SDK's number.
PALM_MATCH_THRESHOLD=

# 1:N only. Minimum gap between the best and second-best candidate before a
# match is trusted. Two people at 0.86 and 0.855 is a coin toss, and at a
# payment terminal a coin toss debits the wrong person's account. Setting this
# to 0 disables the guard, which is only ever correct for 1:1.
PALM_MATCH_MIN_MARGIN=0.05

# ── Mono: the rail that moves the CUSTOMER's money ──────────────────────
# Leg 1 of a purchase. Mono debits the customer's linked bank account; leg 2
# spends MiliPay's own pre-funded VTPass wallet. Two separate pots.
#
# Sandbox: Mono has no separate sandbox host. A test_ secret key IS sandbox,
# and MILIPAY_ENVIRONMENT is checked against that prefix, not the URL.
#
# TWO Mono apps. Mono fixes an app's product when it is created, and a Connect
# app cannot be given the Payments scope later, so bank linking and payments
# need separate apps with separate keys:
#
#   MONO_SECRET_KEY           the CONNECT app: bank linking (link-mono-account)
#                             and identity lookup. Pairs with the mobile app's
#                             EXPO_PUBLIC_MONO_PUBLIC_KEY.
#   MONO_PAYMENTS_SECRET_KEY  the PAYMENTS app: DirectPay / Direct Debit,
#                             verification and refunds. Register the webhook
#                             below on THIS app — Mono sends payment events from
#                             the app whose key started the payment.
#
# Leave MONO_PAYMENTS_SECRET_KEY unset only if one app carries both scopes;
# payments then fall back to MONO_SECRET_KEY.
MONO_SECRET_KEY=
MONO_PAYMENTS_SECRET_KEY=
MONO_PUBLIC_KEY=
MONO_BASE_URL=https://api.withmono.com

# Whether QUICK PAY (Mono Direct Debit mandates) is offered.
#
# directpay  quick pay off: every purchase is approved at the customer's bank
#            on Mono's page. The default.
# mandate    quick pay on: a customer can approve MiliPay ONCE per account
#            (Settings → Linked Banks → Quick pay; they send ₦50 from that
#            account to prove it is theirs), and from then on purchases from
#            that account are fingerprint-only. Accounts without an active
#            mandate — or whose allowance is used up — still pay by DirectPay,
#            so switching this on never blocks a purchase.
# Switch to mandate only once Mono has enabled Direct Debit on the Payments
# app. Switching back to directpay stops every mandate debit immediately.
MONO_PAYMENT_MODE=directpay

# Where Mono sends the customer after its page (DirectPay and quick-pay
# setup). Defaults to milipay://payment-complete, which reopens a built app.
# If Mono refuses a custom scheme, set an https page here instead.
MONO_REDIRECT_URL=

# THE WEBHOOK IS THE MONEY. mono-webhook is deployed with --no-verify-jwt,
# because Mono has no Supabase session, so this secret is the ONLY thing in
# front of the endpoint that authorises MiliPay to spend. Unset means every
# caller is rejected, which is the correct failure direction.
#
# Mono GENERATES this: add the webhook URL on the Payments app, then copy the
# sec_… value it shows next to the webhook. Mono sends it back on every call in
# the mono-webhook-secret header. Re-adding the webhook issues a new one.
MONO_WEBHOOK_SECRET=

# ── WHICH ENVIRONMENT IS THIS? ──────────────────────────────────────────
# sandbox | production. Defaults to sandbox: saying "production" has to be a
# deliberate act, because an unset or misspelled value must land on the side
# that cannot move real money.
#
# This is checked against every provider's own configuration, and a definite
# disagreement is a HARD ERROR rather than a warning. Both directions lose
# money:
#
#   production Mono + sandbox gateway -> real bank debits, nothing delivered
#   sandbox Mono + production gateway -> MiliPay's wallet drained for free
#
# All-sandbox is a fully supported, coherent configuration: every leg runs for
# real against test credentials, so the whole flow can be proved end to end
# without a naira moving anywhere. That is the MVP setup.
#
# Note for Mono: it has no separate sandbox host — test and live both go to
# api.withmono.com — so its environment is read from the KEY PREFIX
# (test_… / live_…), not the URL.
MILIPAY_ENVIRONMENT=sandbox

# ── VTU master switch ───────────────────────────────────────────────────
# Orthogonal to the line above: MILIPAY_ENVIRONMENT says WHICH face of each
# provider, this says WHETHER to call it at all. Defaults to "disabled" and an
# unset value never means "spend".
#
#   disabled   purchases are refused; catalogue browsing still works
#   simulated  purchases are refused with a "test mode" message and no
#              provider is called. It is NOT a stand-in for the sandbox: no
#              success is ever faked on the purchase path.
#   live       providers are really called — against whichever face
#              MILIPAY_ENVIRONMENT selects
#
# The MVP sandbox run is live + MILIPAY_ENVIRONMENT=sandbox: real Mono sandbox
# DirectPay → Mono webhook → real VTPass sandbox.
VTU_FULFILMENT_MODE=disabled

# ── VTPass: the gateway that delivers the VALUE ─────────────────────────
# Leg 2 of a purchase. Paid for out of MiliPay's own PRE-FUNDED VTPass wallet,
# which is a different pot from the customer's money that Mono collects.
#
# Keep that wallet funded. The purchase path reads the balance before the
# customer's bank is ever touched and refuses the sale if it is short, because
# taking someone's money and being unable to deliver is worse than turning the
# sale away.
#
# VTPass is the ONLY fulfilment gateway: purchase, requery, the wallet check and
# the low-wallet alarm all go through it. Every purchase carries a request_id
# derived from the MiliPay reference and the transaction's own timestamp. A
# purchase whose call times out is never paid a second time — the
# reconciliation sweep asks VTPass about that request_id instead.
#
#   sandbox     https://sandbox.vtpass.com/api
#   production  https://vtpass.com/api
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PUBLIC_KEY=

# Optional. The reconciliation sweep logs a warning when the VTPass wallet
# drops below this many naira. Defaults to 20000. Every sale is refused once
# the wallet cannot cover it, so this wants noticing before that point.
VTPASS_WALLET_FLOOR=20000

# ── BigiSub: PARKED, not removed ────────────────────────────────────────
# The adapter (supabase/functions/_shared/bigisub.ts) stays in the repository,
# but nothing live imports it and no BIGISUB_* variable is read by anything:
# setting one routes nothing to BigiSub and changes no VTPass decision, which
# is why none are listed here. It was parked because no BigiSub purchase
# endpoint accepts a client-supplied reference, so a purchase whose call timed
# out could never be resolved by machine.

# Notifications. Customer credentials go out over Termii: WhatsApp first, SMS as
# the fallback. Order is configurable; an empty/invalid value falls back to
# "whatsapp,sms". The password is never returned to the portal that triggered it.
TERMII_API_KEY=
TERMII_SMS_SENDER=MiliPay
TERMII_WHATSAPP_SENDER=MiliPay
# Channels are tried in order; the first success wins.
#   whatsapp,sms -> normal operation
#   console      -> TESTING ONLY. Writes the one-time password to the Edge
#                   Function log instead of sending it, so you can approve a
#                   customer without a Termii account. Reading it needs Supabase
#                   project access, but it is still a credential in a log:
#                   never enable this where real customers exist.
PASSWORD_DELIVERY_CHANNELS=whatsapp,sms

# Transactional email (not used for credential delivery).
RESEND_API_KEY=

# Identity verification (NIN / BVN).
#   simulated -> no provider is called. Deterministic for testing: an ID ending
#                0000 fails, 9999 reports the provider unavailable, anything
#                else verifies. Every result is recorded in
#                public.identity_verifications with mode='simulated', so the
#                cohort that was never really checked stays identifiable.
#   live      -> calls Mono's Lookup API using MONO_SECRET_KEY above.
# Flip this when a real Mono account is issued; no code change is needed.
IDENTITY_VERIFICATION_MODE=simulated

# Permits an enrolment whose palm-vein or facial template is marked SIMULATED.
# Must stay false anywhere real customers are enrolled.
ALLOW_SIMULATED_BIOMETRICS=false

# MiliPay — environment contract
# Copy to .env and fill in. NEVER commit the filled-in file.
#
# Anything prefixed VITE_ or EXPO_PUBLIC_ is compiled into the client bundle and
# is readable by anyone who inspects the app. Operator and platform secrets must
# only ever be set as Supabase Edge Function secrets.

# ─────────────────────────────────────────────────────────────
# Client-safe (web portals)
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Allows the palm scanner to produce a clearly-marked SIMULATED template when no
# HFSecurity hardware is attached. Only honoured in a dev build; simulated
# templates are refused at enrolment unless this is on.
VITE_ALLOW_BIOMETRIC_SIMULATION=false

# ─────────────────────────────────────────────────────────────
# Server-only — Supabase Edge Function secrets
#   supabase secrets set KEY=value
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sovereign palm-vein matching microservice (C++ / VP930 Linux SDK).
# REQUIRED: process-payment declines every transaction while this is unset,
# because an unverified palm must never move money.
PALM_MATCH_URL=
PALM_MATCH_SERVICE_KEY=

# The matcher reports the SDK's own GetRecognitionThreshold and that is what
# applies. This value can only ever TIGHTEN it, never loosen it, so a bad
# deploy cannot make matching more permissive than the algorithm vendor allows.
# Leave it unset to use the SDK's number.
PALM_MATCH_THRESHOLD=

# 1:N only. Minimum gap between the best and second-best candidate before a
# match is trusted. Two people at 0.86 and 0.855 is a coin toss, and at a
# payment terminal a coin toss debits the wrong person's account. Setting this
# to 0 disables the guard, which is only ever correct for 1:1.
PALM_MATCH_MIN_MARGIN=0.05

# Open Banking (Mono DirectPay)
MONO_SECRET_KEY=
MONO_PUBLIC_KEY=

# ── VTU master switch ───────────────────────────────────────────────────
# Fulfilment spends MiliPay's OWN money at VTPass and BigiSub, so this
# defaults to "disabled" and an unset value never means "spend".
#
#   disabled   purchases are refused; catalogue browsing still works
#   simulated  the whole flow runs, no provider is called, nothing is spent
#   live       real money, real airtime
#
# "live" with a sandbox provider URL is a HARD ERROR, not a warning: Mono would
# debit the customer's real bank account while the operator call went to a test
# gateway that credits nobody.
VTU_FULFILMENT_MODE=disabled

# VTU fulfilment — VTPass (airtime, data, electricity, cable)
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_SECRET_KEY=

# VTU fulfilment — BigiSub (SME data — MTN and Airtel ONLY)
# Everything else (all airtime, retail data, Glo/9mobile data, power, cable)
# goes to VTPass.
BIGISUB_BASE_URL=https://api.bigisub.ng
BIGISUB_API_TOKEN=
BIGISUB_TRANSACTION_PIN=

# Notifications. Customer credentials go out over Termii: WhatsApp first, SMS as
# the fallback. Order is configurable; an empty/invalid value falls back to
# "whatsapp,sms". The password is never returned to the portal that triggered it.
TERMII_API_KEY=
TERMII_SMS_SENDER=MiliPay
TERMII_WHATSAPP_SENDER=MiliPay
# Channels are tried in order; the first success wins.
#   whatsapp,sms -> normal operation
#   console      -> TESTING ONLY. Writes the one-time password to the Edge
#                   Function log instead of sending it, so you can approve a
#                   customer without a Termii account. Reading it needs Supabase
#                   project access, but it is still a credential in a log:
#                   never enable this where real customers exist.
PASSWORD_DELIVERY_CHANNELS=whatsapp,sms

# Transactional email (not used for credential delivery).
RESEND_API_KEY=

# Identity verification (NIN / BVN).
#   simulated -> no provider is called. Deterministic for testing: an ID ending
#                0000 fails, 9999 reports the provider unavailable, anything
#                else verifies. Every result is recorded in
#                public.identity_verifications with mode='simulated', so the
#                cohort that was never really checked stays identifiable.
#   live      -> calls Mono's Lookup API using MONO_SECRET_KEY above.
# Flip this when a real Mono account is issued; no code change is needed.
IDENTITY_VERIFICATION_MODE=simulated

# Permits an enrolment whose palm-vein or facial template is marked SIMULATED.
# Must stay false anywhere real customers are enrolled.
ALLOW_SIMULATED_BIOMETRICS=false

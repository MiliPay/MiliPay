{
  "expo": {
    "name": "BioPay",
    "slug": "biopay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-black.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alashabeeb.biopay"
    },
    "android": {
      "package": "com.alashabeeb.biopay",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/icon-black.png"
      }
    },
    "web": {
      "favicon": "./assets/icon-white.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon-white.png",
          "resizeMode": "contain",
          "backgroundColor": "#111827"
        }
      ],
      "expo-status-bar",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "4b20c2a7-4c6e-4f04-8f8a-143b6edb139c"
      }
    },
    "owner": "b.stallon"
  }
}

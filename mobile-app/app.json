{
  "expo": {
    "name": "MiliPay",
    "slug": "biopay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alashabeeb.biopay"
    },
    "android": {
      "package": "com.alashabeeb.biopay",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#065F46",
          "dark": {
            "image": "./assets/splash-mark.png",
            "backgroundColor": "#065F46"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00C896",
          "defaultChannel": "transactions"
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MiliPay uses Face ID to confirm it is you before linking a bank account or approving a payment."
        }
      ],
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "MiliPay opens your contacts only when you tap the contacts button, so you can pick a number to top up."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4b20c2a7-4c6e-4f04-8f8a-143b6edb139c"
      }
    },
    "owner": "b.stallon",
    "description": "Pay with your palm. Airtime, data, electricity and TV, paid straight from your bank account.",
    "scheme": "milipay",
    "primaryColor": "#00C896",
    "backgroundColor": "#080C0A"
  }
}

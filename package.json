{
  "name": "milipay-workspace",
  "private": true,
  "workspaces": [
    "AdminPanel",
    "agent-portal",
    "service-portal",
    "merchant-portal",
    "website",
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "scan-secrets": "node scripts/scan-secrets.mjs --history",
    "scan-secrets:staged": "node scripts/scan-secrets.mjs --staged",
    "check-migrations": "node scripts/check-migrations.mjs",
    "schema-snapshot": "node scripts/schema-snapshot.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.62.5"
  },
  "devDependencies": {
    "pg": "^8.23.1",
    "pg-copy-streams": "^6.0.6",
    "pgsql-parser": "^13.19.1",
    "vitest": "^2.1.9"
  }
}

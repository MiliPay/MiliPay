#!/bin/sh
#
# Blocks a commit that contains anything credential-shaped.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Bypass only when you are certain (and say why in the commit message):
#   git commit --no-verify

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found, skipping secret scan" >&2
  exit 0
fi

node "$(git rev-parse --show-toplevel)/scripts/scan-secrets.mjs" --staged || exit 1
